generator client {
  provider      = "prisma-client-js"
  // "debian-openssl-1.0.x" : cible requise par l'hébergement cPanel (CloudLinux)
  binaryTargets = ["native", "debian-openssl-1.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ─── AUTH & USERS ───
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  password      String?
  image         String?
  role          String    @default("OWNER")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts  Account[]
  sessions  Session[]
  profiles  Profile[]
  eventLogs EventLog[]
}

// ─── PROFILES ───
model Profile {
  id             String   @id @default(cuid())
  userId         String
  slug           String   @unique
  title          String?
  bio            String?
  avatar         String?
  coverImage     String?
  theme          String   @default("minimal")
  appearance     String? // JSON string
  status         String   @default("DRAFT")
  isEmergency    Boolean  @default(false)
  emergencyUrl   String?
  seoTitle       String?
  seoDescription String?
  favicon        String?
  ogImage        String?
  customDomain   String?  @unique
  pixelConfig    String? // JSON string
  webhookUrl     String?
  locale         String   @default("fr")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  links       Link[]
  socialLinks SocialLink[]
  projects    Project[]
  sections    Section[]
  leads       Lead[]
  products    Product[]
  pageViews   PageView[]
  linkEvents  LinkEvent[]
  abTests     ABTest[]
}

// ─── LINKS ───
model Link {
  id          String    @id @default(cuid())
  profileId   String
  sectionId   String?
  title       String
  url         String
  description String?
  thumbnail   String?
  layout      String    @default("LIST")
  priority    Int       @default(0)
  isPinned    Boolean   @default(false)
  status      String    @default("ACTIVE")
  startsAt    DateTime?
  endsAt      DateTime?
  clickCount  Int       @default(0)
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  profile    Profile     @relation(fields: [profileId], references: [id], onDelete: Cascade)
  section    Section?    @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  linkEvents LinkEvent[]
}

// ─── SOCIAL LINKS ───
// Icônes réseaux sociaux affichées sous la bio (GitHub, LinkedIn, X, Instagram…)
model SocialLink {
  id        String   @id @default(cuid())
  profileId String
  platform  String // clé de src/lib/social-platforms.ts
  url       String
  label     String?
  priority  Int      @default(0)
  isVisible Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, priority])
}

// ─── PROJECTS ───
// Cartes "Projets" : réalisations, apps, dépôts, études de cas
model Project {
  id          String   @id @default(cuid())
  profileId   String
  title       String
  description String?  @db.Text
  url         String?
  repoUrl     String?
  image       String?
  tags        String? // séparés par des virgules
  priority    Int      @default(0)
  isVisible   Boolean  @default(true)
  isFeatured  Boolean  @default(false)
  clickCount  Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, priority])
}

// ─── SECTIONS ───
model Section {
  id         String   @id @default(cuid())
  profileId  String
  title      String
  priority   Int      @default(0)
  isVisible  Boolean  @default(true)
  conditions String? // JSON string
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  links   Link[]
}

// ─── PRODUCTS ───
model Product {
  id            String   @id @default(cuid())
  profileId     String
  title         String
  description   String?
  price         Float
  currency      String   @default("EUR")
  image         String?
  stock         Int?
  stripePriceId String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  orders  Order[]
}

model Order {
  id              String   @id @default(cuid())
  productId       String
  stripeSessionId String?  @unique
  customerEmail   String
  customerName    String?
  amount          Float
  currency        String
  status          String   @default("PENDING")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

// ─── LEADS ───
model Lead {
  id        String    @id @default(cuid())
  profileId String
  email     String
  name      String?
  tags      String? // comma-separated
  message   String?
  consent   Boolean   @default(false)
  source    String?
  metadata  String? // JSON string
  readAt    DateTime?
  createdAt DateTime  @default(now())

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

// ─── ANALYTICS ───
model PageView {
  id        String   @id @default(cuid())
  profileId String
  ipHash    String?
  userAgent String?
  referrer  String?
  country   String?
  device    String?
  os        String?
  browser   String?
  createdAt DateTime @default(now())

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, createdAt])
}

model LinkEvent {
  id        String   @id @default(cuid())
  profileId String
  linkId    String
  type      String
  ipHash    String?
  country   String?
  device    String?
  createdAt DateTime @default(now())

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  link    Link    @relation(fields: [linkId], references: [id], onDelete: Cascade)

  @@index([linkId, createdAt])
}

// ─── AUDIT ───
model EventLog {
  id        String   @id @default(cuid())
  userId    String?
  profileId String?
  action    String
  metadata  String? // JSON string
  ipHash    String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
}

// ─── A/B TESTING ───
model ABTest {
  id        String   @id @default(cuid())
  profileId String
  linkId    String?
  name      String
  status    String   @default("RUNNING")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profile  Profile         @relation(fields: [profileId], references: [id], onDelete: Cascade)
  variants ABTestVariant[]
}

model ABTestVariant {
  id         String   @id @default(cuid())
  abTestId   String
  linkId     String?
  title      String
  url        String?
  thumbnail  String?
  weight     Int      @default(50)
  clickCount Int      @default(0)
  viewCount  Int      @default(0)
  createdAt  DateTime @default(now())

  abTest ABTest @relation(fields: [abTestId], references: [id], onDelete: Cascade)
}
