# Base de données (MySQL / MariaDB)
DATABASE_URL="mysql://user:password@localhost:3306/linkfree"

# Auth.js — NEXTAUTH_SECRET : `openssl rand -base64 32`
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-me-min-32-chars"

# OAuth Google (optionnel : le bouton n'apparaît que si les deux sont renseignés)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# URL publique de l'application (métadonnées, QR code, server actions)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Inscription ouverte ("false" pour désactiver les créations de compte)
ALLOW_REGISTRATION="true"

# Compte admin créé par `npm run db:admin`
ADMIN_EMAIL="admin@linkfree.com"
ADMIN_PASSWORD="changez-moi"

# Mot de passe du compte démo créé par `npm run db:seed`
DEMO_PASSWORD="DemoLinkfree2026!"

# Serveur (cPanel / PM2)
PORT=3000
HOST=127.0.0.1
